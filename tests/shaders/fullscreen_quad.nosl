UV :: #inout(f32x2, 0)

Vertex :: struct {
	pos: f32x3,
	uv:  f32x2,
}

Vert_Data :: struct {
	verts: [^]Vertex,
}

VS_Out :: struct {
	pos: f32x4 | SV_Position,
	uv:  f32x2 | UV,
}

vert :: proc "vertex"(
	vert_id: u32 | SV_Vertex,
	data: ^Vert_Data | SV_Data,
) -> (out: VS_Out) {
	v := data.verts[vert_id]
	out.pos = f32x4(v.pos, 1)
	out.uv = v.uv
	return out
}

Frag_Data :: struct {
	texture: t32_2d,
	sampler: s32,
}

frag :: proc "fragment"(
	input: VS_Out,
	data: ^Frag_Data | SV_Data,
) -> (out: f32x4 | SV_Target) {
	out = sample(data.texture, data.sampler, input.uv)
	return out
}

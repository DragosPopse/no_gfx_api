PI :: 3.1415

Data :: struct {
	output_texture:  rw32_2d,
	accum_counter:   u32,
	camera_to_world: f32x4x4,
}

Ray :: struct {
	ori: f32x3,
	dir: f32x3,
}

Hit_Info :: struct {
	hit:    b32,
	t:      f32,
	normal: f32x3,
}

hash_u32 :: proc(seed: u32) -> u32 {
	x := seed
	x = x ~ (x >> 17)
	x = x * 0xed5ad4bb
	x = x ~ (x >> 11)
	x = x * 0xac4c1b51
	x = x ~ (x >> 15)
	x = x * 0x31848bab
	x = x ~ (x >> 14)
	return x
}

init_rng :: proc(#ref rng: u32, global_id: u32, accum_counter: u32) {
	rng = hash_u32((global_id * 19349663) ~ (accum_counter * 83492791))
}

random_u32 :: proc(#ref rng: u32) -> u32 {
	rng *= 747796405 + 2891336453
	result := ((rng >> ((rng >> 28) + 4)) ~ rng) * 277803737
	result = (result >> 22) ~ result
	return result
}

random_f32 :: proc(#ref rng: u32) -> f32 {
	rng *= 747796405 + 2891336453
	result := ((rng >> ((rng >> 28) + 4)) ~ rng) * 277803737
	result = (result >> 22) ~ result
	return f32(result) / 4294967295
}

random_vec2 :: proc(#ref rng: u32) -> f32x2 {
	rnd0 := random_f32(&rng)
	rnd1 := random_f32(&rng)
	return f32x2(rnd0, rnd1)
}

copysignf :: proc(magnitude: f32, sgn: f32) -> f32 {
	return magnitude if sgn > 0 else -magnitude
}

basis_fromz :: proc(v: f32x3) -> f32x4x4 {
	// https://graphics.pixar.com/library/OrthonormalB/paper.pdf
	z := normalize(v)
	sign := copysignf(1, z.z)
	a := -1 / (sign + z.z)
	b := z.x * z.y * a
	x := f32x3(1 + sign * z.x * z.x * a, sign * b, -sign * z.x)
	y := f32x3(b, sign + z.y * z.y * a, -z.y)
	return f32x4x4(
		x.x, x.y, x.z, 0,
		y.x, y.y, y.z, 0,
		z.x, z.y, z.z, 0,
		0, 0, 0, 0,
	)
}

sample_hemisphere_cos :: proc(normal: f32x3, ruv: f32x2) -> f32x3 {
	z := sqrt(ruv.y)
	r := sqrt(1 - z * z)
	phi := 2 * PI * ruv.x
	local_direction := f32x3(r * cos(phi), r * sin(phi), z)
	return normalize(basis_fromz(normal) * f32x4(local_direction, 0)).xyz
}

sample_hemisphere_cos_pdf :: proc(normal: f32x3, direction: f32x3) -> f32 {
	cosw := dot(normal, direction)
	return 0 if cosw <= 0 else cosw / PI
}

sample_matte :: proc(color: f32x3, normal: f32x3, outgoing: f32x3, rn: f32x2) -> f32x3 {
	_ = color
	_ = outgoing
	return sample_hemisphere_cos(normal, rn)
}

eval_matte :: proc(color: f32x3, normal: f32x3, outgoing: f32x3, incoming: f32x3) -> f32x3 {
	_ = outgoing
	return color / PI * abs(dot(normal, incoming))
}

sample_matte_pdf :: proc(color: f32x3, normal: f32x3, outgoing: f32x3, incoming: f32x3) -> f32 {
	_ = color
	_ = outgoing
	return sample_hemisphere_cos_pdf(normal, incoming)
}

is_finite :: proc(v: f32x3) -> b32 {
	is_x := (u32_from_f32_bits(v.x) & 0x7F800000) != 0x7F800000
	is_y := (u32_from_f32_bits(v.y) & 0x7F800000) != 0x7F800000
	is_z := (u32_from_f32_bits(v.z) & 0x7F800000) != 0x7F800000
	return is_x && is_y && is_z
}

intersect_sphere :: proc(ray: Ray, hit_info: Hit_Info, pos: f32x3, radius: f32) -> Hit_Info {
	oc := ray.ori - pos
	a := dot(ray.dir, ray.dir)
	b := 2 * dot(oc, ray.dir)
	c := dot(oc, oc) - radius * radius
	discriminant := b * b - 4 * a * c

	intersection := discriminant >= 0
	dist := f32(0)
	if intersection {
		t0 := (-b + sqrt(discriminant)) / (2 * a)
		t1 := (-b - sqrt(discriminant)) / (2 * a)
		dist = min(t0, t1) * f32(intersection)
		if dist < 0.001 do intersection = false
	}
	if !intersection do return hit_info

	info := hit_info
	if !info.hit || info.t > dist {
		info.hit = true
		info.t = dist
		hit_pos := ray.ori + ray.dir * dist
		info.normal = normalize(hit_pos - pos)
	}
	return info
}

ray_scene_intersection :: proc(ray: Ray) -> Hit_Info {
	hit_info: Hit_Info
	hit_info = intersect_sphere(ray, hit_info, f32x3(0, 0.5, 0), 0.5)
	hit_info = intersect_sphere(ray, hit_info, f32x3(-1.2, 0.8, -0.5), 0.8)
	hit_info = intersect_sphere(ray, hit_info, f32x3(0.8, 0.2, -0.2), 0.2)
	hit_info = intersect_sphere(ray, hit_info, f32x3(0, -10000, 0), 10000)
	return hit_info
}

all_zero :: proc(v: f32x3) -> b32 {
	return all(v == 0)
}

pathtrace :: proc(#ref rng: u32, start_ray: Ray) -> f32x3 {
	radiance := f32x3(0, 0, 0)
	weight := f32x3(1, 1, 1)
	ray := start_ray
	albedo_color := f32x3(0.9, 0.9, 0.9)
	max_bounces := 5

	for bounce := 0; bounce <= max_bounces; bounce += 1 {
		hit := ray_scene_intersection(ray)
		if !hit.hit {
			coords := f32x2(atan2(ray.dir.x, ray.dir.z) / (2 * 3.1415), acos(clamp(ray.dir.y, -1, 1)) / 3.1415)
			emission := lerp(f32x3(0.8, 0.7, 0.1), f32x3(0.1, 0.2, 0.8), f32x3(coords.y)) * 2
			radiance += emission * weight
			break
		}

		outgoing := -ray.dir
		rnd := random_vec2(&rng)
		incoming := sample_matte(albedo_color, hit.normal, outgoing, rnd)
		if all_zero(incoming) do break

		prob := sample_matte_pdf(albedo_color, hit.normal, outgoing, incoming)
		weight *= eval_matte(albedo_color, hit.normal, outgoing, incoming) / prob

		ray.ori += ray.dir * hit.t
		ray.dir = incoming

		if all_zero(weight) || !is_finite(weight) do break

		if bounce > 3 {
			survive_prob := min(0.99, max(weight.x, max(weight.y, weight.z)))
			if random_f32(&rng) >= survive_prob do break
			weight /= survive_prob
		}
	}
	return radiance
}

@(size = {8, 8})
main :: proc "compute"(
	data: ^Data | SV_Data,
	gid: [3]u32 | SV_Global_Thread,
) {
	sz := dim(data.output_texture)
	rng: u32
	init_rng(&rng, gid.y * u32(sz.x) + gid.x, data.accum_counter)

	uv := f32x2(f32(gid.x), f32(gid.y)) / f32x2(f32(sz.x), f32(sz.y))
	coord := 2 * uv - 1
	coord *= tan((90 * PI / 180) / 2)
	coord.y *= f32(sz.y) / f32(sz.x)

	world_camera_pos := (data.camera_to_world * f32x4(0, 0, 0, 1)).xyz
	camera_lookat := normalize(f32x3(coord, 1))
	world_camera_lookat := normalize(data.camera_to_world * f32x4(camera_lookat, 0)).xyz

	camera_ray: Ray
	camera_ray.ori = world_camera_pos
	camera_ray.dir = world_camera_lookat
	color := pathtrace(&rng, camera_ray)

	if gid.x < u32(sz.x) && gid.y < u32(sz.y) {
		if data.accum_counter > 1 {
			weight := 1 / f32(data.accum_counter)
			prev_color := load(data.output_texture, i32x2(i32(gid.x), i32(gid.y))).xyz
			color = prev_color * (1 - weight) + color * weight
			color = max(color, f32x3(0, 0, 0))
		}
		store(data.output_texture, i32x2(i32(gid.x), i32(gid.y)), f32x4(color, 1))
	}
}

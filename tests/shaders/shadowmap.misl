LIGHT_POS :: #inout(f32x4, 0)
WORLD_NORMAL :: #inout(f32x4, 1)

Data :: struct {
	positions:              [^]f32x4,
	normals:                [^]f32x4,
	model_to_world:         f32x4x4,
	model_to_world_normal:  f32x4x4,
	world_to_view:          f32x4x4,
	world_to_light:         f32x4x4,
	view_to_proj:           f32x4x4,
}

VS_Out :: struct {
	pos:          f32x4 | SV_Position,
	light_pos:    f32x4 | LIGHT_POS,
	world_normal: f32x4 | WORLD_NORMAL,
}

vert :: proc "vertex"(
	vert_id: u32 | SV_Vertex,
	data: ^Data | SV_Data,
) -> (out: VS_Out) {
	model_pos := f32x4(data.positions[vert_id].xyz, 1)
	world_pos := data.model_to_world * model_pos
	light_pos := data.world_to_light * world_pos
	light_pos.y = -light_pos.y
	view_pos := data.world_to_view * world_pos
	clip_pos := data.view_to_proj * view_pos
	clip_pos.y = -clip_pos.y

	world_normal := data.model_to_world_normal * data.normals[vert_id]
	// Sponza normals point backward on Z relative to these coordinates.
	world_normal.z = -world_normal.z

	out.pos = clip_pos
	out.world_normal = world_normal
	out.light_pos = light_pos
	return out
}

Frag_Data :: struct {
	shadow_texture: t32_2d,
	shadow_sampler: s32_cmp,
	light_dir:      f32x3,
}

frag :: proc "fragment"(
	input: VS_Out,
	data: ^Frag_Data | SV_Data,
) -> (out: f32x4 | SV_Target) {
	light_pos := input.light_pos.xyz / input.light_pos.w
	normal := normalize(input.world_normal.xyz)
	factor := dot(normal, normalize(data.light_dir))
	factor = max(0, factor)

	light_pos.xy = light_pos.xy * 0.5 + 0.5

	// Shadow maps use a comparison sampler so the hardware can PCF.
	light := sample(data.shadow_texture, data.shadow_sampler, light_pos.xy, light_pos.z)
	if light_pos.x < 0 || light_pos.y < 0 || light_pos.x > 1 || light_pos.y > 1 {
		light = 0
	}
	light = max(light, 0.2)
	sun_colour := f32x3(1.3, 1.2, 1.0)
	ambient_colour := f32x3(0.5, 0.7, 0.9)
	out = f32x4(
		(0.1 + factor * 0.1) * ambient_colour + sun_colour * factor * light * 0.8,
		1,
	)
	return out
}

shadow_frag :: proc "fragment"(input: VS_Out) {
	_ = input
}

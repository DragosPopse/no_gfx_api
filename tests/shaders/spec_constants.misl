COLOR :: #inout(f32x4, 0)

Vertex :: struct {
	pos:   f32x3,
	color: f32x3,
}

Data :: struct {
	verts: [^]Vertex,
}

VS_Out :: struct {
	pos:   f32x4 | SV_Position,
	color: f32x4 | COLOR,
}

@(specialization_constant = 0)
spec_const_int: u32 = 4

@(specialization_constant = 1)
mask_out_red: b32 = false

@(specialization_constant = 2)
mask_out_green: b32 = true

@(specialization_constant = 3)
mask_out_blue: b32 = false

vert :: proc "vertex"(
	vert_id: u32 | SV_Vertex,
	data: ^Data | SV_Data,
) -> (out: VS_Out) {
	v := data.verts[vert_id]
	out.pos = f32x4(v.pos, 1)
	out.color = f32x4(v.color, 1)
	return out
}

frag :: proc "fragment"(input: VS_Out) -> (out: f32x4 | SV_Target) {
	out = input.color
	if mask_out_red do out.r = 0
	if mask_out_green do out.g = 0
	if mask_out_blue do out.b = 0
	if spec_const_int != 1 do out = f32x4(0, 0, 0, 0)
	return out
}

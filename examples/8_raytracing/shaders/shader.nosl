UV :: #inout(f32x2, 0)

Vertex :: struct
{
    pos: f32x3,
    uv:  f32x2,
}

Vert_Data :: struct
{
    verts: [^]Vertex,
}

VS_Out :: struct
{
    pos: f32x4 | SV_Position,
    uv:  f32x2 | UV,
}

vert :: proc "vertex"(vid: u32 | SV_Vertex, data: ^Vert_Data | SV_Data) -> (out: VS_Out)
{
    v := data.verts[vid]
    out.pos = f32x4(v.pos, 1)
    out.uv = v.uv
    return out
}

Frag_Data :: struct
{
    tex:  t32_2d,
    samp: s32,
}

linear_to_srgb :: proc(color: f32x4) -> f32x4
{
    cutoff := f32x3(
        f32(1) if color.x < 0.0031308 else f32(0),
        f32(1) if color.y < 0.0031308 else f32(0),
        f32(1) if color.z < 0.0031308 else f32(0),
    )
    higher := f32x3(1.055) * pow(color.xyz, f32x3(1 / 2.4)) - f32x3(0.055)
    lower := color.xyz * f32x3(12.92)
    return f32x4(lerp(higher, lower, cutoff), color.w)
}

filmic :: proc(x: f32x3) -> f32x3
{
    X := max(f32x3(0), x - 0.004)
    result := (X * (6.2 * X + 0.5)) / (X * (6.2 * X + 1.7) + 0.06)
    return pow(result, f32x3(2.2))
}

hdr_to_ldr :: proc(color: f32x4) -> f32x4
{
    return f32x4(filmic(color.xyz), color.w)
}

frag :: proc "fragment"(input: VS_Out, data: ^Frag_Data | SV_Data) -> (out: f32x4 | SV_Target)
{
    linear := sample(data.tex, data.samp, input.uv)
    out = linear_to_srgb(hdr_to_ldr(max(f32x4(0, 0, 0, 0), linear)))
    return out
}

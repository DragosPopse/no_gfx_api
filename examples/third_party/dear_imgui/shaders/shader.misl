COLOR :: #inout(f32x4, 0)

Vertex :: struct
{
    pos:   f32x4,
    color: f32x4,
}

Vert_Data :: struct
{
    verts: [^]Vertex,
}

VS_Out :: struct
{
    pos:   f32x4 | SV_Position,
    color: f32x4 | COLOR,
}

vert :: proc "vertex"(vid: u32 | SV_Vertex, data: ^Vert_Data | SV_Data) -> (out: VS_Out)
{
    v := data.verts[vid]
    out.pos = f32x4(v.pos.xyz, 1)
    out.color = v.color
    return out
}

frag :: proc "fragment"(input: VS_Out) -> (out: f32x4 | SV_Target)
{
    out = input.color
    return out
}

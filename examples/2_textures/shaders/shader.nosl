UV :: #inout(f32x2, 0)

Vertex :: struct
{
    pos: f32x3,
    uv:  f32x2,
}

Vert_Data :: struct
{
    verts: [^]Vertex,
}

VS_Out :: struct
{
    pos: f32x4 | SV_Position,
    uv:  f32x2 | UV,
}

vert :: proc "vertex"(vid: u32 | SV_Vertex, data: ^Vert_Data | SV_Data) -> (out: VS_Out)
{
    v := data.verts[vid]
    out.pos = f32x4(v.pos, 1)
    out.uv = v.uv
    return out
}

Frag_Data :: struct
{
    texture_a: t32_2d,
    texture_b: t32_2d,
    samp:      s32,
    fade:      f32,
}

frag :: proc "fragment"(input: VS_Out, data: ^Frag_Data | SV_Data) -> (out: f32x4 | SV_Target)
{
    uv := input.uv
    out = lerp(sample(data.texture_a, data.samp, uv), sample(data.texture_b, data.samp, uv), data.fade)
    return out
}

degrees_f32 :: proc(x: f32) -> f32 {
	return 57.2957795131 * x
}

degrees_f32x2 :: proc(x: [2]f32) -> [2]f32 {
	return [2]f32{degrees_f32(x.x), degrees_f32(x.y)}
}
